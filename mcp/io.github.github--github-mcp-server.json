{
    "serverId": "io.github.github/github-mcp-server",
    "date": "2026-05-20",
    "config": {
        "type": "streamable-http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
            "Authorization": "Bearer ${GITHUB_PAT}"
        },
        "notes": "GITHUB_PAT holds a GitHub personal access token (or GitHub App token) that has the scopes required for the GitHub features you want to use. It is sent as a Bearer token in the Authorization header.",
        "serverKey": "github"
    },
    "installConfigs": [
        {
            "tool": "theia-ide",
            "config": "derived"
        },
        {
            "tool": "theia-ide-next",
            "config": "derived"
        }
    ]
}
