{
    "serverId": "io.github.tavily-ai/tavily-mcp",
    "date": "2026-06-01",
    "config": {
        "type": "stdio",
        "command": "npx",
        "args": [
            "-y",
            "tavily-mcp@latest"
        ],
        "env": {
            "TAVILY_API_KEY": "${TAVILY_API_KEY}"
        },
        "notes": "TAVILY_API_KEY holds a Tavily API key from https://app.tavily.com/. Provides real-time web search and extraction tools optimized for LLMs.",
        "serverKey": "tavily"
    },
    "installConfigs": [
        {
            "tool": "theia-ide",
            "config": "derived"
        },
        {
            "tool": "theia-ide-next",
            "config": "derived"
        }
    ]
}
