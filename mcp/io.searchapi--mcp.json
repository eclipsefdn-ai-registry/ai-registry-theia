{
    "serverId": "io.searchapi/mcp",
    "date": "2026-05-27",
    "config": {
        "type": "streamable-http",
        "url": "https://www.searchapi.io/mcp",
        "headers": {
            "X-MCP-Token": "${SEARCHAPI_MCP_TOKEN}"
        },
        "notes": "SEARCHAPI_MCP_TOKEN holds an MCP token from https://www.searchapi.io/mcp_integrations. It is sent in the X-MCP-Token header. Provides real-time web, news, image and other search engine results.",
        "serverKey": "searchapi"
    },
    "installConfigs": [
        {
            "tool": "theia-ide",
            "config": "derived"
        },
        {
            "tool": "theia-ide-next",
            "config": "derived"
        }
    ]
}
