{
    "serverId": "io.github.firecrawl/firecrawl-mcp-server",
    "date": "2026-06-01",
    "config": {
        "type": "stdio",
        "command": "npx",
        "args": [
            "-y",
            "firecrawl-mcp@latest"
        ],
        "env": {
            "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
        },
        "notes": "FIRECRAWL_API_KEY holds an API key from https://www.firecrawl.dev/. Provides web scraping, crawling, and structured data extraction tools.",
        "serverKey": "firecrawl"
    },
    "installConfigs": [
        {
            "tool": "theia-ide",
            "config": "derived"
        },
        {
            "tool": "theia-ide-next",
            "config": "derived"
        }
    ]
}
